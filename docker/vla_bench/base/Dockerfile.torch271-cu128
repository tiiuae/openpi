# VLA-bench shared base — torch271-cu128
# Built once, reused by every model on this torch version. Keeps eleven images from each carrying
# their own copy of a 7-15 GB torch stack.
#
#   docker build -f base/Dockerfile.torch271-cu128 -t vla-bench-base:torch271-cu128 .
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_ROOT_USER_ACTION=ignore \
    TOKENIZERS_PARALLELISM=false \
    HF_HUB_DISABLE_XET=1 \
    OPENPI_CLIENT_SRC=/opt/openpi-client/src

# libglib2.0-0 was renamed libglib2.0-0t64 in Ubuntu 24.04 (noble), which the torch>=2.8 images use;
# the torch 2.2/2.7 images are still jammy. Ask for whichever this base actually has.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ffmpeg libgl1 ca-certificates curl \
    && (apt-get install -y --no-install-recommends libglib2.0-0t64 \
        || apt-get install -y --no-install-recommends libglib2.0-0) \
    && rm -rf /var/lib/apt/lists/*

# The wire codec and the websocket layer. msgpack_numpy is copied in from openpi at build time so the
# bytes on the wire are identical to production rather than a re-implementation.
RUN pip install --no-cache-dir "websockets>=12" msgpack numpy pillow

WORKDIR /app
